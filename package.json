{
  "name": "b-z",
  "productName": "B-Z",
  "version": "1.0.0",
  "description": "B-Z: an AI network doctor for Windows. Scans your PC, Ethernet/Wi-Fi, router, DNS and internet, then fixes what's broken.",
  "main": "main.js",
  "author": "B-Z",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/selftest.js",
    "build": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bz.netdoctor",
    "productName": "B-Z",
    "copyright": "MIT",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "B-Z-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "B-Z-Portable-${version}.${ext}"
    }
  }
}
